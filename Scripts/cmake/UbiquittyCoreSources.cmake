# What ubiquitty-core compiles: the canonical portable-Core list, the vendored
# sources it carries, and the generated translation units. Paths in
# UBIQUITTY_CORE_SOURCES are relative to UBIQUITTY_CORE_SOURCE_DIR, which owns
# every entry; every other list here is absolute. A consumer includes this file
# at its top directory: the vendored sources' properties are set on that
# directory.
#
#   UBIQUITTY_CORE_SOURCES, UBIQUITTY_BUNDLED_BACKENDS
#   UBIQUITTY_RE2_DIR, UBIQUITTY_RE2_SOURCES
#   UBIQUITTY_SIMDUTF_DIR, UBIQUITTY_SIMDUTF_SOURCES
#   UBIQUITTY_YYJSON_SOURCE
#   UBIQUITTY_CORE_IOS_BACKEND_SOURCES, UBIQUITTY_QUIC_CLIENT_SOURCES
#   ubiquitty_apply_third_party_policy(<sources...>)
#   ubiquitty_core_subset(<out-var> [ABSOLUTE] EXCLUDE|KEEP_ONLY <files...>)
#   ubiquitty_embed_builtin_themes(<out-var> [COMMENT <text>] [TARGET <target>])
#   ubiquitty_link_quic_archives(<target> <scope> <prefix>)
#   ubiquitty_generate_completions_header(<header>)
#   ubiquitty_generate_shell_integration_source(<source>)
include_guard(GLOBAL)

include("${CMAKE_CURRENT_LIST_DIR}/UbiquittyCoreRoot.cmake")
ubiquitty_require_top_directory(UbiquittyCoreSources.cmake)

# ----------------------------------------------------------------------
# Canonical portable-Core source set — read once, shared by every frontend.
#
# Scripts/portable-core-sources.txt is the single source of truth for the
# portable Core translation units (mechanically regenerated by
# Scripts/gen-portable-core-sources.sh, also read by the bash perf drivers).
# Parsing it once lets the ubiquitty-core lib and the host/agent/linux
# executables derive their Core link set from one list instead of each
# hand-maintaining an overlapping copy (the drift hazard this list prevents). A
# frontend that links only a subset trims it explicitly via
# ubiquitty_core_subset(... EXCLUDE ...) below; a new Core .cpp added to the
# canonical list then flows into every frontend automatically unless that
# frontend names it in its trim list.
#
# The list is read at configure time, so editing it re-runs the configure:
# otherwise a Core .cpp added to it leaves every configured build tree linking
# the stale list until a manual reconfigure.
# ----------------------------------------------------------------------
file(STRINGS "${UBIQUITTY_CORE_SOURCE_DIR}/Scripts/portable-core-sources.txt"
    _ubiquitty_core_source_lines)
set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS
    "${UBIQUITTY_CORE_SOURCE_DIR}/Scripts/portable-core-sources.txt")
set(UBIQUITTY_CORE_SOURCES "")
foreach(_line IN LISTS _ubiquitty_core_source_lines)
    string(STRIP "${_line}" _line)
    # Accept only Source/....cpp paths; comments + blanks are ignored
    # structurally (no dependence on # being the first byte). Paths stay
    # repo-relative so a frontend can REMOVE_ITEM by the same spelling; a
    # target roots them at UBIQUITTY_CORE_SOURCE_DIR, which owns every entry.
    if(_line MATCHES "^Source/.+\\.cpp$")
        list(APPEND UBIQUITTY_CORE_SOURCES "${_line}")
    endif()
endforeach()
list(LENGTH UBIQUITTY_CORE_SOURCES _ubiquitty_core_source_count)
if(_ubiquitty_core_source_count LESS 50)
    message(FATAL_ERROR
        "portable-Core: only ${_ubiquitty_core_source_count} sources parsed from "
        "Scripts/portable-core-sources.txt — list missing or malformed?")
endif()

# wasm32 (emscripten) swaps the bundled POSIX backends for the Wasm ones: wasm
# has no fork / PTY / persistent filesystem, no local-socket namespace, and no
# way to block waiting for readiness on the thread that would deliver it. The
# frontend half of the PAL (clock / clipboard / bell) is supplied by the
# embedder, unchanged.
# The bundled backends, named once. Both the core source list and the L3b layer
# list swap the same set, and a backend added to one and not the other fails the
# partition assertion in ubiquitty_add_core_layer_libraries()
# (UbiquittyCoreLibrary.cmake) rather than at the link — but only after someone
# builds for wasm, which is not most days.
set(UBIQUITTY_BUNDLED_BACKENDS SystemPAL Preferences Poll Socket SocketPath Spawn)
if(EMSCRIPTEN)
    foreach(_backend IN LISTS UBIQUITTY_BUNDLED_BACKENDS)
        list(REMOVE_ITEM UBIQUITTY_CORE_SOURCES Source/Platform/POSIX/${_backend}.cpp)
        list(APPEND UBIQUITTY_CORE_SOURCES Source/Platform/Wasm/${_backend}.cpp)
    endforeach()
endif()

# iOS swaps the one bundled backend whose facility the platform does not have.
#
# A swap rather than a trim, and the difference is what the subset gate reads: a
# trimmed Spawn.cpp leaves every caller of spawnPipedCommand referencing a symbol
# no kept translation unit defines, which is precisely the cut the gate exists to
# refuse. Swapping keeps the symbol and changes its answer — the backend reports
# the capability absent, so the binary carries no fork and no execve while the
# code that merely names one still links.
#
# The rest of the POSIX set stays: sockets, polling, preferences and the system
# PAL all work here. Only starting a child does not.
if(CMAKE_SYSTEM_NAME STREQUAL "iOS")
    list(REMOVE_ITEM UBIQUITTY_CORE_SOURCES Source/Platform/POSIX/Spawn.cpp)
    list(APPEND UBIQUITTY_CORE_SOURCES Source/Platform/iOS/Spawn.cpp)
    list(REMOVE_ITEM UBIQUITTY_CORE_SOURCES Source/Platform/POSIX/ProcessSpawnAndWait.cpp)
    list(APPEND UBIQUITTY_CORE_SOURCES Source/Platform/iOS/ProcessSpawnAndWait.cpp)
endif()

# ubiquitty_core_subset(<out-var> [ABSOLUTE] KEEP_ONLY... | EXCLUDE...) —
# resolve a frontend's Core link set from the canonical list.
#   EXCLUDE <files...>   start from the full canonical list, drop these.
#   KEEP_ONLY <files...> start empty, keep only these (order = canonical).
#   ABSOLUTE             root the result at UBIQUITTY_CORE_SOURCE_DIR; without
#                        it the result is repo-relative.
# The named files are always repo-relative. Asserts every named file is actually
# in the canonical list, so a typo or a Core file that left the SSOT fails
# configure instead of silently dropping a TU from the build.
function(ubiquitty_core_subset out_var)
    set(_mode "")
    set(_named "")
    set(_absolute OFF)
    foreach(_arg IN LISTS ARGN)
        if(_arg STREQUAL "EXCLUDE" OR _arg STREQUAL "KEEP_ONLY")
            set(_mode "${_arg}")
        elseif(_arg STREQUAL "ABSOLUTE")
            set(_absolute ON)
        else()
            list(APPEND _named "${_arg}")
        endif()
    endforeach()
    foreach(_f IN LISTS _named)
        if(NOT _f IN_LIST UBIQUITTY_CORE_SOURCES)
            message(FATAL_ERROR
                "ubiquitty_core_subset: '${_f}' is not in the canonical "
                "Scripts/portable-core-sources.txt — stale name?")
        endif()
    endforeach()
    if(_mode STREQUAL "EXCLUDE")
        set(_result ${UBIQUITTY_CORE_SOURCES})
        if(_named)
            list(REMOVE_ITEM _result ${_named})
        endif()
    elseif(_mode STREQUAL "KEEP_ONLY")
        set(_result "")
        foreach(_c IN LISTS UBIQUITTY_CORE_SOURCES)
            if(_c IN_LIST _named)
                list(APPEND _result "${_c}")
            endif()
        endforeach()
    else()
        message(FATAL_ERROR "ubiquitty_core_subset: need EXCLUDE or KEEP_ONLY")
    endif()
    if(_absolute)
        list(TRANSFORM _result PREPEND "${UBIQUITTY_CORE_SOURCE_DIR}/")
    endif()
    set(${out_var} "${_result}" PARENT_SCOPE)
endfunction()

# The ThirdParty policy, which every vendored C++ translation unit compiles
# under: exceptions and RTTI restored, which vendored C++ assumes and our
# targets otherwise disable; -Werror defeated and warnings suppressed (-w), since
# the code is vendored, not ours to fix, and its diagnostics are noise in our
# build. A source's properties hold in the directory that sets them alone, so
# each directory that compiles a vendored source applies the policy there.
#
# - Parameters:
#   - ARGN: The vendored C++ sources, given the policy in the calling directory.
function(ubiquitty_apply_third_party_policy)
    set_source_files_properties(${ARGN} PROPERTIES
        COMPILE_OPTIONS "-fexceptions;-frtti;-Wno-error;-w")
endfunction()

# RE2 — the linear-time regex engine behind Core/ScrollSearch. Vendored
# pre-Abseil release (Source/ThirdParty/re2, 2023-03-01). Any target whose
# Core subset keeps Source/Core/Screen/ScrollSearch.cpp links these TUs and adds
# UBIQUITTY_RE2_DIR to its include path; a target that trims ScrollSearch
# (Agent) takes neither. The vendored TUs carry the ThirdParty policy.
set(UBIQUITTY_RE2_DIR "${UBIQUITTY_CORE_SOURCE_DIR}/Source/ThirdParty/re2")
file(GLOB UBIQUITTY_RE2_SOURCES "${UBIQUITTY_RE2_DIR}/re2/*.cc")
list(APPEND UBIQUITTY_RE2_SOURCES
    "${UBIQUITTY_RE2_DIR}/util/rune.cc"
    "${UBIQUITTY_RE2_DIR}/util/strutil.cc")
ubiquitty_apply_third_party_policy(${UBIQUITTY_RE2_SOURCES})

# simdutf — the SIMD UTF-8 and base64 kernels (Source/ThirdParty/simdutf,
# v9.0.0, one amalgamated TU). Every target that compiles portable Core takes
# it, because Core/Codec/Base64.cpp calls it unconditionally: a codec that
# decodes one way on one platform and another way elsewhere is the shape a
# frontend divergence hides in, and this is an attacker-reachable decoder.
#
# There is no build-time gate on it. A macro answering "is simdutf here" made
# every include of it conditional and the scalar side of that fork unreachable
# from the lane anyone ran, which is a second implementation of an
# attacker-reachable decoder that nothing exercises.
#
# It compiles on every arm this tree builds on, the alpine g++ floor and
# emscripten included. The amalgamation dispatches on the arch at runtime, so
# it carries the ThirdParty policy the way re2 does.
set(UBIQUITTY_SIMDUTF_DIR "${UBIQUITTY_CORE_SOURCE_DIR}/Source/ThirdParty/simdutf")
set(UBIQUITTY_SIMDUTF_SOURCES "${UBIQUITTY_SIMDUTF_DIR}/simdutf.cpp")
ubiquitty_apply_third_party_policy(${UBIQUITTY_SIMDUTF_SOURCES})

# yyjson — the JSON parser Codec/JSON.cpp wraps (Source/ThirdParty/yyjson), so
# every target compiling a Core subset that keeps Codec/JSON.cpp compiles it too.
# A C translation unit among C++ ones: -std=c99 keeps a target's C++ options off
# it, and it carries the ThirdParty policy the way re2 and simdutf do, so its
# diagnostics are noise rather than a build that fails on a compiler bump under
# UBIQUITTY_WERROR.
set(UBIQUITTY_YYJSON_SOURCE "${UBIQUITTY_CORE_SOURCE_DIR}/Source/ThirdParty/yyjson/yyjson.c")
set_source_files_properties(${UBIQUITTY_YYJSON_SOURCE} PROPERTIES
    COMPILE_FLAGS "-std=c99 -Wno-error -w")

# The PAL backends an iOS build of Core adds to the canonical list: the PTY
# factory that refuses, since the platform starts no local shell; the clipboard
# entry point the Swift shell installs its sink into; and the Darwin clock the
# AppKit shell shares.
set(UBIQUITTY_CORE_IOS_BACKEND_SOURCES
    "${UBIQUITTY_CORE_SOURCE_DIR}/Source/Platform/iOS/PTYStream.cpp"
    "${UBIQUITTY_CORE_SOURCE_DIR}/Source/Platform/iOS/Clipboard.cpp"
    "${UBIQUITTY_CORE_SOURCE_DIR}/Source/Platform/Apple/Clock.cpp")

# The client half of the QUIC transport (ngtcp2 + AWS-LC): the portable client,
# the datagram batch its pumps read and write through, and the channel a session
# attaches over. A target compiling them defines UBIQUITTY_QUIC=1, takes the
# dependencies' include directory and links their archives.
set(UBIQUITTY_QUIC_CLIENT_SOURCES
    "${UBIQUITTY_CORE_SOURCE_DIR}/Source/Platform/POSIX/QUICClient.cpp"
    "${UBIQUITTY_CORE_SOURCE_DIR}/Source/Platform/POSIX/DatagramBatch.cpp"
    "${UBIQUITTY_CORE_SOURCE_DIR}/Source/Core/Transport/QUICChannel.cpp")

# Links the QUIC dependencies' static archives, most-dependent first, as a
# linker that resolves archives in one pass needs: the crypto backend, ngtcp2,
# then AWS-LC's ssl and crypto. AWS-LC is self-contained crypto, so no platform
# framework joins them.
#
# - Parameters:
#   - target: The target that links them.
#   - scope: PUBLIC, PRIVATE or INTERFACE.
#   - prefix: The prefix ubiquitty_ensure_quic_deps() completed for the platform.
function(ubiquitty_link_quic_archives target scope prefix)
    target_link_libraries(${target} ${scope}
        "${prefix}/lib/libngtcp2_crypto_boringssl.a"
        "${prefix}/lib/libngtcp2.a"
        "${prefix}/lib/libssl.a"
        "${prefix}/lib/libcrypto.a")
endfunction()

# Built-in themes ship as TOML (Source/Core/Themes/builtin-themes.toml), one
# source of truth parsed at startup like user themes. Themes.cpp, in the
# canonical list, parses the builtinThemesTOML symbol this generated translation
# unit defines, so a target compiling Themes.cpp compiles it too or links short.
#
# Each call generates its own copy, for the one target that compiles it: Xcode
# refuses a custom command attached to two targets. The first in a directory is
# generated in that directory's binary directory, and each later one under a
# subdirectory of it named for its TARGET.
#
# - Parameters:
#   - out_var: Receives the generated source.
#   - COMMENT: What the build prints while generating it.
#   - TARGET: The target that compiles it, which a second call in one directory
#     needs.
function(ubiquitty_embed_builtin_themes out_var)
    cmake_parse_arguments(PARSE_ARGV 1 _ubq_themes "" "COMMENT;TARGET" "")
    find_package(Python3 COMPONENTS Interpreter REQUIRED)
    set(_toml "${UBIQUITTY_CORE_SOURCE_DIR}/Source/Core/Themes/builtin-themes.toml")
    set(_script "${UBIQUITTY_CORE_SOURCE_DIR}/Scripts/embed-builtin-themes.py")
    set(_output "${CMAKE_CURRENT_BINARY_DIR}/BuiltinThemesData.gen.cpp")
    get_property(_generated DIRECTORY PROPERTY UBIQUITTY_BUILTIN_THEMES_SOURCES)
    if(_output IN_LIST _generated)
        if(NOT _ubq_themes_TARGET)
            message(FATAL_ERROR
                "ubiquitty_embed_builtin_themes() is called again in ${CMAKE_CURRENT_SOURCE_DIR}, "
                "where ${_output} is generated already. Name the TARGET that compiles this copy.")
        endif()
        set(_output "${CMAKE_CURRENT_BINARY_DIR}/${_ubq_themes_TARGET}/BuiltinThemesData.gen.cpp")
        if(_output IN_LIST _generated)
            message(FATAL_ERROR
                "ubiquitty_embed_builtin_themes() is called twice for ${_ubq_themes_TARGET} "
                "in ${CMAKE_CURRENT_SOURCE_DIR}.")
        endif()
        file(MAKE_DIRECTORY "${CMAKE_CURRENT_BINARY_DIR}/${_ubq_themes_TARGET}")
    endif()
    set_property(DIRECTORY APPEND PROPERTY UBIQUITTY_BUILTIN_THEMES_SOURCES "${_output}")
    set(_comment "")
    if(DEFINED _ubq_themes_COMMENT)
        set(_comment COMMENT "${_ubq_themes_COMMENT}")
    endif()
    add_custom_command(
        OUTPUT "${_output}"
        COMMAND "${Python3_EXECUTABLE}" "${_script}" "${_toml}" "${_output}"
        DEPENDS "${_toml}" "${_script}"
        ${_comment}
        VERBATIM)
    set(${out_var} "${_output}" PARENT_SCOPE)
endfunction()

# Embed the canonical shell-completion scripts (Resources/shell-integration/*)
# into a generated header so `ubq completions bash|zsh` can print
# them with no install footprint. Single source of truth: the Resource files.
# A long raw-string delimiter that cannot appear inside a shell script keeps
# arbitrary script bytes literal.
function(ubiquitty_generate_completions_header out_header)
    file(READ "${UBIQUITTY_CORE_SOURCE_DIR}/Resources/shell-integration/ubq.bash" _bash)
    file(READ "${UBIQUITTY_CORE_SOURCE_DIR}/Resources/shell-integration/ubq.zsh" _zsh)
    set(_content "// Generated by CMake from Resources/shell-integration/*. DO NOT EDIT.\n")
    string(APPEND _content "#pragma once\n")
    string(APPEND _content "namespace Ubiquitty { namespace Agent {\n")
    string(APPEND _content "inline const char* bashCompletion = R\"UBQCOMPLETION(${_bash})UBQCOMPLETION\";\n")
    string(APPEND _content "inline const char* zshCompletion = R\"UBQCOMPLETION(${_zsh})UBQCOMPLETION\";\n")
    string(APPEND _content "} }\n")
    file(WRITE "${out_header}" "${_content}")
endfunction()

# Embed the shell-integration scripts (Resources/shell-integration/*) in the
# host binary, which writes them to its control directory for the shells it
# starts: a host copied to another machine carries no Resources directory. The
# file is rewritten only when its bytes change, and editing a script
# reconfigures.
function(ubiquitty_generate_shell_integration_source out_source)
    set(_content "// Generated by CMake from Resources/shell-integration/*. DO NOT EDIT.\n")
    string(APPEND _content "#include \"Platform/Host/ShellIntegrationFiles.h\"\n\n")
    string(APPEND _content "namespace Ubiquitty::Host {\n\n")
    string(APPEND _content "std::span<const ShellIntegrationScript> shellIntegrationScripts()\n{\n")
    string(APPEND _content "    static constexpr ShellIntegrationScript scripts[] {\n")
    foreach(_name bash.sh zsh.sh fish.fish)
        set(_path "${UBIQUITTY_CORE_SOURCE_DIR}/Resources/shell-integration/${_name}")
        file(READ "${_path}" _body)
        set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${_path}")
        string(APPEND _content "        { \"${_name}\", R\"UBQINTEGRATION(${_body})UBQINTEGRATION\" },\n")
    endforeach()
    string(APPEND _content "    };\n    return scripts;\n}\n\n} // namespace Ubiquitty::Host\n")
    set(_existing "")
    if(EXISTS "${out_source}")
        file(READ "${out_source}" _existing)
    endif()
    if(NOT _existing STREQUAL _content)
        file(WRITE "${out_source}" "${_content}")
    endif()
endfunction()
